{
  "id": "anthropic-router",
  "name": "Anthropic Router",
  "description": "Route requests to the cheapest Anthropic model (Haiku/Sonnet/Opus) based on complexity",
  "configSchema": {
    "type": "object",
    "properties": {
      "tiers": {
        "type": "object",
        "description": "Override tier → model mapping",
        "properties": {
          "SIMPLE": { "type": "string" },
          "MEDIUM": { "type": "string" },
          "COMPLEX": { "type": "string" }
        }
      },
      "scoring": {
        "type": "object",
        "description": "Override scoring configuration (weights, keywords, thresholds)"
      },
      "forceModel": {
        "type": "string",
        "description": "Force a specific model for all requests (testing)"
      },
      "logEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable JSONL logging of routing decisions"
      },
      "logPath": {
        "type": "string",
        "default": "~/.openclaw/routing-log.jsonl",
        "description": "Path to JSONL log file"
      }
    }
  },
  "uiHints": {
    "forceModel": {
      "label": "Force Model",
      "placeholder": "anthropic/claude-sonnet-4-20250514"
    }
  }
}
